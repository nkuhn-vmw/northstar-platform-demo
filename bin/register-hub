#!/usr/bin/env python3
"""Register a Hub OAuth client for an existing gateway's advertised URL."""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from northstar_kit.config import ConfigError, load_config
from northstar_kit.hub import register

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--config', type=Path, required=True)
parser.add_argument('--gateway-url', required=True)
parser.add_argument('--apply', action='store_true')
parser.add_argument('--phase', type=int, choices=range(3, 5), default=4)
parser.add_argument('--mode', choices=['cumulative', 'phase-spaces'], default='cumulative')
args = parser.parse_args()
try:
    print(json.dumps(register(load_config(args.config), args.gateway_url, args.apply, args.phase, args.mode), indent=2))
except (ConfigError, OSError) as error:
    print('Hub client registration failed: ' + str(error), file=sys.stderr)
    sys.exit(1)
